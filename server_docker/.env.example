# Public WebUI/API port on the host
APP_PORT=18770

# Multi-user authentication: only seeds the FIRST admin on initial startup.
# Later password/role changes use data/auth.db exclusively.
# Set WEBUI_COOKIE_SECURE=false only for HTTP-only local development.
# Optional: one-time owner selection when upgrading an existing multi-user
# database that has no protected owner. Defaults to WEBUI_USERNAME.
# For new installations, use the same value as WEBUI_USERNAME.
# Once is_superadmin=1 is persisted, changing this setting cannot transfer it.
# SUPERADMIN_BOOTSTRAP_USERNAME=admin
WEBUI_COOKIE_SECURE=true
# Initial administrator bootstrap credentials (also accepted as Basic API
# credentials until password is changed in the UI).
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change-this-password

# Flask session signing key. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-random-64-hex

# Browserless auth token. Generate with: openssl rand -hex 24
BROWSERLESS_TOKEN=replace-with-random-token

# Optional absolute public URL override. Leave blank behind Nginx/Caddy/Cloudflare
# and enable TRUST_PROXY_HEADERS so links follow the real public domain.
PUBLIC_BASE_URL=

# Usually leave BROWSERLESS_URL unset so scripts/deploy.sh can auto-detect
# and safely reuse a compatible running Browserless when possible.
# BROWSERLESS_URL=http://host.docker.internal:3080

# Optional image override for a clean host with no Browserless image.
# Pin a version/digest in production instead of floating latest.
# BROWSERLESS_IMAGE=browserless/chrome@sha256:57d19e414d9fe4ae9d2ab12ba768c97f38d51246c5b31af55a009205c136012f

# Trust X-Forwarded-* only behind a reverse proxy you control
TRUST_PROXY_HEADERS=false
PROXY_HOPS=1

# Retry count for transient parse/download failures
MAX_PARSE_ATTEMPTS=3
# Max running + queued parse jobs (Browserless worker concurrency remains 1)
MAX_PENDING_JOBS=8
# Recommended client polling interval for async jobs (seconds, clamped to 1..30)
POLL_INTERVAL_SECONDS=3

# Browser/card timing: allow up to 110 seconds for the Yuanbao video card
BROWSER_TIMEOUT=300
BROWSERLESS_CONNECTION_TIMEOUT=360000

# Optional local SenseVoice worker, enabled only after offline worker/queue setup.
LOCAL_TRANSCRIPTION_ENABLED=false
LOCAL_TRANSCRIPTION_TIMEOUT=4500

# SenseVoice only; no Whisper fallback for this project.
LOCAL_TRANSCRIPTION_MODEL=sensevoice
